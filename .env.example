# Vercel / Resend contact form configuration (set these in Vercel Project Settings > Environment Variables)
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender in your Resend account, e.g. DJAGO <hello@your-domain.com>
RESEND_FROM_EMAIL=DJAGO <hello@your-verified-domain.com>
# Comma-separated recipients are supported
RESEND_TO_EMAIL=Djagodesignbuild@gmail.com
